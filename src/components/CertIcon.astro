---
// Generic certificate/badge mark (not a third-party logo). Decorative.
interface Props { size?: number }
const { size = 18 } = Astro.props;
---
<svg class="cert-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <circle cx="12" cy="9" r="6" />
  <path d="M9.5 9.2l1.7 1.7 3.4-3.4" />
  <path d="M8.5 14.2 7 22l5-2.6 5 2.6-1.5-7.8" />
</svg>

<style>
  .cert-icon { flex: none; color: var(--accent-text); }
</style>
