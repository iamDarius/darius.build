---
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'Senior Software Engineer',
  description: site.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Bethesda', addressRegion: 'MD', addressCountry: 'US' },
  sameAs: Object.values(site.social),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#F2F1EC" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'ember') document.documentElement.dataset.theme = 'ember';
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>

    <div class="banner">
      <div class="container banner-inner">
        <span class="banner-tag">{site.version}</span>
        <span>Built in public. Resume and case studies are live; services, the Lab and the newsletter are on the way.</span>
      </div>
    </div>

    <header class="nav">
      <nav class="container nav-inner" aria-label="Main">
        <a href="/" class="logo">darius<span>.</span>build</a>
        <div class="links">
          <a href="/#work">Work</a>
          <a href="/resume" aria-current={path.startsWith('/resume') ? 'page' : undefined}>Resume</a>
          <a href="/#soon" class="soon">Services <small>soon</small></a>
          <a href="/#soon" class="soon">Lab <small>soon</small></a>
        </div>
        <div class="nav-actions">
          <button type="button" class="theme" data-theme-toggle aria-label="Switch to dark theme">
            <svg class="moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a href={`mailto:${site.email}`} class="btn btn-accent nav-cta">Get in touch</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} {site.name} · {site.location} · {site.version}</span>
        <div class="row">
          <a href={site.social.linkedin}>LinkedIn</a>
          <a href={site.social.github}>GitHub</a>
          <a href={site.social.medium}>Medium</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        function sync() {
          var dark = document.documentElement.dataset.theme === 'ember';
          btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#110D0C' : '#F2F1EC');
        }
        sync();
        btn.addEventListener('click', function () {
          var dark = document.documentElement.dataset.theme === 'ember';
          if (dark) delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = 'ember';
          try { localStorage.setItem('theme', dark ? 'ivory' : 'ember'); } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; background: var(--ink); color: var(--on-ink); padding: 10px 16px; border-radius: 8px; z-index: 100; }
  .skip:focus { left: 8px; }

  .banner { background: var(--band); color: var(--band-text-2); font-size: 14px; }
  .banner-inner { display: flex; gap: 12px; align-items: center; justify-content: center; flex-wrap: wrap; padding-top: 11px; padding-bottom: 11px; text-align: center; }
  .banner-tag { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--band-label); }

  .nav { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--ground) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 16px; padding-bottom: 16px; }
  .logo { font-family: var(--font-display); font-weight: 700; font-size: 20px; letter-spacing: -0.01em; text-decoration: none; }
  .logo span { color: var(--accent-text); }
  .links { display: flex; gap: 28px; font-size: 15px; }
  .links a { text-decoration: none; color: var(--text-2); }
  .links a:hover, .links a[aria-current] { color: var(--text); }
  .links .soon { color: var(--muted); }
  .links small { font-family: var(--font-mono); font-size: 11px; }
  .nav-actions { display: flex; gap: 10px; align-items: center; }
  .theme { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; border: 1px solid var(--border-strong); background: transparent; color: var(--text); cursor: pointer; }
  .theme .sun { display: none; }
  :global([data-theme='ember']) .theme .sun { display: block; }
  :global([data-theme='ember']) .theme .moon { display: none; }
  .nav-cta { min-height: 44px; padding: 0 20px; font-size: 15px; }
  @media (max-width: 860px) { .links { display: none; } }
  @media (max-width: 380px) { .nav-cta { padding: 0 14px; } }

  .footer { border-top: 1px solid var(--border); font-size: 14px; color: var(--muted); }
  .footer-inner { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding-top: 32px; padding-bottom: 32px; }
  .footer a { color: var(--text-2); }
</style>
