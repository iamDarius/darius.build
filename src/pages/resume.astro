---
import Base from '../layouts/Base.astro';
import CertIcon from '../components/CertIcon.astro';
import { resume, YEARS, certifications } from '../data/resume';
import { site } from '../config/site';
---
<Base
  title="Resume"
  description={`Senior software engineer: ${YEARS} years of Angular, TypeScript and enterprise software, now specializing in AI and agentic workflows with Claude Code.`}
>
  <div class="container">
    <header class="head">
      <p class="label">Resume</p>
      <h1 class="h1 title">Senior software engineer. AI &amp; agentic workflows.</h1>
      <p class="lede">{resume.summary}</p>
      <div class="row">
        {site.resumePdf && <a href={site.resumePdf} class="btn btn-ink" download>Download resume (PDF)</a>}
        <a href={`mailto:${site.email}`} class="btn btn-accent">Email me</a>
        <a href={site.social.linkedin} class="btn btn-ghost">LinkedIn</a>
      </div>
    </header>

    <div class="layout">
      <section aria-labelledby="exp">
        <h2 id="exp" class="label sub-label">Experience</h2>
        {resume.experience.map((e) => (
          <div class="job">
            <div class="job-head">
              <h3 class="job-role">{e.role} · <span class="muted">{e.org}</span></h3>
              <span class="meta">{e.dates}</span>
            </div>
            <p class="meta sub">{e.location}{e.earlier && ` · Previously ${e.earlier}`}</p>
            <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}

        <h2 class="label sub-label section-gap">Certifications</h2>
        <ul class="cert-list">
          {certifications.map((c) => (
            <li>
              <div class="cert-main">
                <span class="cert-badge"><CertIcon size={20} /></span>
                <div>
                <h3 class="job-role">{c.verifyUrl ? <a href={c.verifyUrl}>{c.name}</a> : c.name}</h3>
                <p class="muted detail">Course certificate · {c.issuer}</p>
                </div>
              </div>
              <span class="meta">{c.date}</span>
            </li>
          ))}
        </ul>

        <h2 class="label sub-label ventures">Ventures</h2>
        {resume.ventures.map((v) => (
          <div class="job">
            <h3 class="job-role">{v.role} · <span class="muted">{v.org}</span></h3>
            <p class="muted detail">{v.detail}</p>
          </div>
        ))}
      </section>

      <aside aria-label="Skills and education">
        <h2 class="label sub-label">Skills</h2>
        {resume.skills.map((s) => (
          <div class="skill">
            <span class="meta">{s.group}</span>
            <ul class="chips">{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
        <div class="skill">
          <span class="meta">Education</span>
          <p class="edu">{resume.education.school}<br /><span class="muted">{resume.education.degree}</span></p>
        </div>
        <div class="skill">
          <span class="meta">Selected work</span>
          <p class="edu"><a href="/#work">Case studies →</a></p>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: 24px; padding: 88px 0 64px; }
  .title { font-size: clamp(40px, 5.4vw, 64px); max-width: 900px; }
  .lede { max-width: 760px; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 72px; padding-bottom: 120px; }
  .sub-label { margin-bottom: 24px; }
  .ventures { margin-top: 56px; }
  .job { border-top: 1px solid var(--border); padding: 28px 0; }
  .job-head { display: flex; justify-content: space-between; gap: 8px 16px; flex-wrap: wrap; align-items: baseline; }
  .job-role { margin: 0; font-family: var(--font-display); font-size: 22px; font-weight: 600; line-height: 1.3; }
  .sub { margin: 6px 0 0; }
  .job ul { margin: 12px 0 0; padding-left: 20px; color: var(--text-2); line-height: 1.75; }
  .job li + li { margin-top: 6px; }
  .detail { margin: 8px 0 0; }
  .skill { margin-bottom: 28px; }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 0; }
  .chips li { font-size: 14px; padding: 6px 14px; border: 1px solid var(--border-strong); border-radius: var(--radius-pill); color: var(--text-2); }
  .edu { margin: 8px 0 0; }
  .section-gap { margin-top: 56px; }
  .cert-list { list-style: none; margin: 0; padding: 0; }
  .cert-list li { display: flex; padding-left: 0; justify-content: space-between; align-items: baseline; gap: 8px 16px; flex-wrap: wrap; border-top: 1px solid var(--border); padding: 22px 0; }
  .cert-list .job-role { font-size: 20px; }
  .cert-main { display: flex; gap: 14px; align-items: flex-start; }
  .cert-badge { width: 40px; height: 40px; flex: none; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; background: var(--raised); border: 1px solid var(--border); }
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; gap: 24px; }
    .head { padding: 56px 0 40px; }
  }
</style>
